# ============================================================================
# CultCrate: environment variables
# Copy to .env.local for development; set the same names in Vercel for production.
# NEVER commit real values. Only this example file is tracked by git (.gitignore).
# ============================================================================

# ----------------------------------------------------------------------------
# PUBLIC (shipped to the browser, so they must start with NEXT_PUBLIC_)
# These are inlined at BUILD time: after changing one, redeploy.
# ----------------------------------------------------------------------------

# Canonical production URL (no trailing slash). Used for metadataBase, Open Graph and sitemap-related URLs.
NEXT_PUBLIC_APP_URL=https://cultcrate.com

# Supabase: Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase: Project Settings > API > publishable (anon) key. Safe to expose; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# ----------------------------------------------------------------------------
# SERVER-ONLY SECRETS (must NOT start with NEXT_PUBLIC_)
# ----------------------------------------------------------------------------

# Supabase: Project Settings > API > service_role secret.
# Bypasses ALL Row Level Security. Used only by the /admin API routes (utils/supabase/admin.ts, server-only).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional platform-wide Gemini fallback key (used by /api/synthesize when a request has no key of its own).
# Signed-in users supply their own key in Settings, so this can be left empty.
GEMINI_API_KEY=

# ----------------------------------------------------------------------------
# OPTIONAL
# ----------------------------------------------------------------------------

# Force the first Gemini model to try. Leave unset to auto-discover the best model for each key.
# GEMINI_MODEL=

# Development only (AI Studio). Do NOT set in production.
# DISABLE_HMR=
